// Included by both the Release *and* the Profile build configurations of the Runner target
// — that is the stock Flutter arrangement, and the Podfile's `project` mapping declares
// 'Profile' => :release to match, so CocoaPods generates release-flavoured pod settings for
// profile builds.
#include? "Pods/Target Support Files/Pods-Runner/Pods-Runner.release.xcconfig"
#include "Generated.xcconfig"
