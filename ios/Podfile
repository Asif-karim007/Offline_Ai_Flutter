# Uncomment this line to define a global platform for your project
platform :ios, '13.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  # Plain dynamic frameworks — Flutter's default. An earlier version of this file forced
  # `:linkage => :static` specifically so llama_shim.cpp's object code would land directly in
  # the Runner executable, for `DynamicLibrary.process()` to find on the Dart side. That
  # fought CocoaPods and Xcode the entire way: a static linker only keeps object code
  # something references, and nothing at compile time ever calls an `lc_*` function — Dart
  # only reaches them through `dlsym` at runtime. Every combination of `-force_load`,
  # `-Wl,-u,symbol`, `-all_load` and dead-code-stripping settings tried here either dropped
  # the symbols, stripped them back out, or duplicated CocoaPods' own dummy anchor object.
  #
  # `llama_shim` is a genuine dynamic framework now (see llama_shim.podspec), embedded in the
  # app bundle like any other framework, and `llama_library.dart` opens it by path
  # (`DynamicLibrary.open('@rpath/llama_shim.framework/llama_shim')`) instead of scanning the
  # main executable. A dynamic library's exported symbols are never subject to the static
  # linker's reference-counting in the first place, which is what actually fixes this.
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  # Not a Flutter plugin — `flutter_install_all_ios_pods` above only looks for a podspec
  # named after each pubspec.yaml plugin, so llama_shim.podspec (living right next to
  # llama_bindings.podspec, inside the same plugin's ios/ directory) needs to be pulled in
  # explicitly. See llama_bindings.podspec for why the shim is a second pod at all.
  pod 'llama_shim', :path => File.join('.symlinks', 'plugins', 'llama_bindings', 'ios')

  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  # `llama_shim` is a dynamic framework now, so its exported symbols are never subject to
  # dead-code-stripping or archive-member selection in the first place — the elaborate
  # STRIP_STYLE/DEAD_CODE_STRIPPING forcing this block used to do (for a static-linkage
  # design that fought Xcode's linker the whole way) is gone. What is left is routine.
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '13.0'

      # 32-bit simulator slices have not existed since Xcode 12, but some transitive pods
      # still advertise i386 and break the simulator build if it is not excluded.
      config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = 'i386'
    end
  end
end
