<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        INTERNET is required only by the two optional network features: web search (off by
        default, and inert until a search provider API key is configured) and downloading a
        model from the model manager. Nothing in the generation path makes a network call —
        inference, retrieval, and memory compaction are entirely on-device. Removing this
        permission would leave the app fully functional for offline chat.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="Offline AI Chat"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="false"
        android:largeHeap="true"
        android:enableOnBackInvokedCallback="true">

        <!--
            largeHeap: the model weights themselves are native allocations (llama.cpp
            mmaps/mallocs them outside the managed heap), so this flag does not raise their
            ceiling directly. It matters for two other reasons, both real on a
            multi-gigabyte model:

              1. It raises the managed-heap cap for the first-launch asset copy, which moves
                 the bundled GGUF across the platform channel in chunks through Java byte
                 arrays. (Hand-importing a model is gone; a catalog download streams straight
                 to disk from Dart and never touches the managed heap.)
              2. It marks the process as memory-hungry, which several vendor memory
                 policies and the ActivityManager's own trimming heuristics consult before
                 deciding which background process to kill. A 2-4 GB resident process
                 without this flag is a much easier target.

            It is not a substitute for choosing a model that fits the device; see the
            "Memory-pressure termination" row of the README's debugging table.
        -->

        <!-- Flutter 3.44 supports Android's predictive-back dispatcher. Enabling it removes
             the platform warning and keeps back events routed through Flutter's navigator. -->

        <!--
            Deliberately NOT set here: android:extractNativeLibs. It is derived from
            packagingOptions.jniLibs.useLegacyPackaging in app/build.gradle (false =>
            extractNativeLibs=false). Hardcoding it in the manifest would silently win over
            the packaging option and can leave the APK's .so files packaged in a way that
            breaks 16 KB page alignment on Android 15.
        -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">

            <!--
                Shown while the Flutter engine warms up. On this app the wait is longer than
                usual, because the first frame is gated on the model manager's disk scan.
            -->
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

    <!--
        Required so the text-selection toolbar can enumerate PROCESS_TEXT handlers on
        Android 11+. This is a package-visibility query, not a permission.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
    </queries>
</manifest>
