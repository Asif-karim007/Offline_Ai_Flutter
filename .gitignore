coverage/

# ---------------------------------------------------------------------------------------
# Project-specific: large build artifacts and model weights
# ---------------------------------------------------------------------------------------

# scripts/build_llama_{ios,android}.sh clone llama.cpp and build it here. Tens of GB.
.build/

# The iOS xcframework, produced by scripts/build_llama_ios.sh (or copied from the Swift
# app). Vendored by the podspec, never committed — it is a multi-hundred-megabyte binary.
packages/llama_bindings/ios/Frameworks/
packages/llama_bindings/macos/Frameworks/

# The Android prebuilt .so files and headers, produced by scripts/build_llama_android.sh
# and imported by packages/llama_bindings/src/CMakeLists.txt. Same reasoning.
packages/llama_bindings/android/prebuilt/

# GGUF model weights. Never in git history — a quantized 0.8B model is already half a
# gigabyte and the repo would never recover from one bad commit. See
# assets/models/README.md.
assets/models/*.gguf
